{
  "name": "worktreeview",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=11"
    }
