{
  "name": "worktreeview",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=11"
    }
  },
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite",
    "dev:lab": "fuser -k 1420/tcp 2>/dev/null; npm run dev:web",
    "build": "tauri build",
    "build:web": "npm run check && vite build",
    "build:e2e": "npm run check && vite build --mode e2e",
    "check": "tsc --noEmit && tsc -p tsconfig.node.json",
    "preview": "vite preview",
    "tauri": "tauri",
    "test:desktop": "bash scripts/test-desktop.sh",
    "test:unit": "node --test src/navigation.test.ts src/diff.test.ts src/zoom.test.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "lucide-react": "^0.575.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "@wdio/cli": "9.31.6",
    "@wdio/local-runner": "9.31.6",
    "@wdio/mocha-framework": "9.31.6",
    "@wdio/spec-reporter": "9.31.2",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "webdriverio": "9.31.6"
  },
  "overrides": {
    "serialize-javascript": "^7.1.1",
    "@puppeteer/browsers": "^3.2.2"
  }
}
